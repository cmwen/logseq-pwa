{
  "name": "loam-logseq-pwa",
  "version": "0.0.0",
  "description": "A local-first PWA for reading, editing, and connecting Logseq pages",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "git clean -Xdf && rm -rf packages/**/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "keywords": [
    "logseq",
    "pwa",
    "local-first",
    "github-pages",
    "preact"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmwen/logseq-pwa.git"
  }
}
