{
  "name": "@loam/cli",
  "version": "0.1.0",
  "description": "CLI for local-first Logseq graph operations and the Loam web client",
  "keywords": [
    "cli",
    "command-line"
  ],
  "type": "module",
  "main": "dist/bundled.js",
  "types": "dist/index.d.ts",
  "bin": "dist/bundled.js",
  "files": [
    "dist/bundled.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && pnpm build:bundle",
    "build:bundle": "node scripts/rolldown-bundle.js",
    "prepare": "tsc -b && pnpm build:bundle",
    "test": "vitest run",
    "lint": "biome check --write src test",
    "lint:ci": "biome check src test",
    "format": "biome format --write src test",
    "format:check": "biome format src test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "@loam/core": "workspace:*",
    "@loam/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "preact": "^10.29.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@preact/preset-vite": "^2.10.5",
    "rolldown": "1.0.0-rc.12",
    "vitest": "latest",
    "vite": "^8.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmwen/logseq-pwa.git",
    "directory": "packages/cli"
  },
  "license": "MIT"
}
